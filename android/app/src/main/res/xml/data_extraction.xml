<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing of the app goes to a backup or to a new phone (Android 12 and later copy an app to a new phone whatever allowBackup says): its sign-in is in the
     WebView's cookies, and a new phone signs in again. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
