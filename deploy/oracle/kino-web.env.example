# /etc/kino-web.env: the website's settings on the Oracle box (they were on Render's Environment page). root:kino-web, mode 640.
# Nothing here is a secret; the values below the line are, and live only in the box's copy. A later line wins, so an empty line
# below a filled one empties it.
PORT=8787
HOST=127.0.0.1
NODE_ENV=production
# One proxy in front (Caddy); Cloudflare's addresses are passed over by src/server/trust.ts.
TRUST_PROXY=1
DATA_DIR=/var/lib/kino-web
# The video goes through the relay on this same box, never through the website. The address is used as it is (signedRelayUrl).
EDGE_STREAM_PROXY_URL=https://kino-relay.24-7.ro/api/proxy
PROXY_VIDEO=off
# With PROXY_VIDEO=off the website carries subtitles and no film. To have it carry film from particular hosts all the same (a place that answers
# only to this box's own address and cannot go through the relay), name them, divided by commas; a name covers every name under it. Empty: none.
# Every host named here can be asked for anything through the website, so name whole hosts of a provider, not a top-level domain.
# PROXY_EXEMPT_HOSTS=cdn.example,media.example
CAT_COMPANION=on
# No TMDB_API_KEY line: unset means the built-in key (src/server/library/filmpire.ts), and an empty one would mean no key at all.
# ---- secrets: from Render's Environment page (EDGE_STREAM_PROXY_KEY is the relay's STREAM_RELAY_KEY, in /etc/kino-relay.env) ----
EDGE_STREAM_PROXY_KEY=
DATABASE_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URIS=
FEEDBACK_ADMIN_TOKEN=
